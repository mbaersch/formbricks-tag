___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const injectScript = require('injectScript');
const callInWindow = require('callInWindow');
const templateStorage = require('templateStorage');
const makeString = require('makeString');
const getType = require('getType');

let appUrl = makeString(data.appUrl || 'https://app.formbricks.com');
if (appUrl.charAt(appUrl.length - 1) === '/') appUrl = appUrl.slice(0, -1);

// callInWindow silently skips async functions (returns undefined without calling them). All
// queued Formbricks methods are async, so they are called via Function.prototype.call instead.
const callAsync = (method, arg) => callInWindow('formbricks.' + method + '.call', null, arg);

const isEmpty = (value) => {
  const type = getType(value);
  return type === 'undefined' || type === 'null' || value === '';
};

// Formbricks rejects anything but string, number, boolean and null (null removes the key)
const toValue = (value) => {
  if (isEmpty(value)) return null;
  const type = getType(value);
  if (type === 'string' || type === 'number' || type === 'boolean') return value;
  return makeString(value);
};

const runMethods = () => {
  if (data.identifyUser === true && !isEmpty(data.userId)) {
    callAsync('setUserId', makeString(data.userId));
    if (!isEmpty(data.userEmail)) callAsync('setEmail', makeString(data.userEmail));
    const attributes = {};
    let attributeCount = 0;
    (data.userAttributes || []).forEach(x => {
      if (isEmpty(x.attributeValue)) return;
      attributes[makeString(x.attributeKey)] = toValue(x.attributeValue);
      attributeCount++;
    });
    if (attributeCount > 0) callAsync('setAttributes', attributes);
  }

  if (data.changeLanguage === true && !isEmpty(data.language)) {
    callAsync('setLanguage', makeString(data.language));
  }

  if (data.setHiddenFields === true) {
    if (data.clearHiddenFields === true) callInWindow('formbricks.clearEmbeddedData');
    if (data.hiddenFields && data.hiddenFields.length > 0) {
      const fields = {};
      data.hiddenFields.forEach(x => {
        fields[makeString(x.fieldKey)] = toValue(x.fieldValue);
      });
      callInWindow('formbricks.setEmbeddedData', fields);
    }
  }

  if (data.trackAction === true && !isEmpty(data.actionName)) {
    callAsync('track', makeString(data.actionName));
  }
};

const onLoad = () => {
  if (templateStorage.getItem('setupReady')) {
    runMethods();
  } else {
    // Formbricks drops queued methods called before setup has finished. Its events are not
    // replayed, so the listener has to be registered before setup() is called.
    callInWindow('formbricks.on', 'formbricks_setup_successful', () => {
      templateStorage.setItem('setupReady', true);
      runMethods();
    });
    // injectScript calls onSuccess on every tag execution, setup must only run once per page
    if (!templateStorage.getItem('setupDone')) {
      templateStorage.setItem('setupDone', true);
      callAsync('setup', {
        workspaceId: makeString(data.workspaceId),
        appUrl: appUrl
      });
    }
  }
  data.gtmOnSuccess();
};

injectScript(appUrl + '/js/formbricks.umd.cjs', onLoad, data.gtmOnFailure, 'formbricks');


