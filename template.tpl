___TESTS___

scenarios:
- name: setup is called once, methods wait for setup event
  code: |-
    let setupCalls = 0;
    mock('callInWindow', (name) => {
      if (name === 'formbricks.setup.call') setupCalls++;
    });
    mockData.trackAction = true;
    mockData.actionName = 'checkout';
    runCode(mockData);
    runCode(mockData);
    assertThat(setupCalls).isEqualTo(1);
    assertApi('callInWindow').wasCalledWith('formbricks.setup.call', null, {
      workspaceId: 'test-workspace',
      appUrl: 'https://app.formbricks.com'
    });
    assertApi('callInWindow').wasNotCalledWith('formbricks.track.call', null, 'checkout');
    assertApi('gtmOnSuccess').wasCalled();
- name: methods run after setup event
  code: |-
    mock('callInWindow', (name, eventName, callback) => {
      if (name === 'formbricks.on') callback();
    });
    mockData.identifyUser = true;
    mockData.userId = 'u123';
    mockData.userEmail = '';
    mockData.userAttributes = [
      {attributeKey: 'plan', attributeValue: 'pro'},
      {attributeKey: 'company', attributeValue: undefined}
    ];
    mockData.changeLanguage = true;
    mockData.language = 'de';
    mockData.setHiddenFields = true;
    mockData.clearHiddenFields = true;
    mockData.hiddenFields = [
      {fieldKey: 'plan', fieldValue: 'pro'},
      {fieldKey: 'items', fieldValue: 3},
      {fieldKey: 'page_type', fieldValue: ''}
    ];
    mockData.trackAction = true;
    mockData.actionName = 'checkout';
    runCode(mockData);
    assertApi('callInWindow').wasCalledWith('formbricks.setUserId.call', null, 'u123');
    assertApi('callInWindow').wasNotCalledWith('formbricks.setEmail.call', null, '');
    assertApi('callInWindow').wasCalledWith('formbricks.setAttributes.call', null, {plan: 'pro'});
    assertApi('callInWindow').wasCalledWith('formbricks.setLanguage.call', null, 'de');
    assertApi('callInWindow').wasCalledWith('formbricks.clearEmbeddedData');
    assertApi('callInWindow').wasCalledWith('formbricks.setEmbeddedData', {
      plan: 'pro',
      items: 3,
      page_type: null
    });
    assertApi('callInWindow').wasCalledWith('formbricks.track.call', null, 'checkout');
- name: later tag runs methods directly without setup
  code: |-
    let setupCalls = 0;
    mock('callInWindow', (name, eventName, callback) => {
      if (name === 'formbricks.setup.call') setupCalls++;
      if (name === 'formbricks.on') callback();
    });
    runCode(mockData);
    mockData.trackAction = true;
    mockData.actionName = 'checkout';
    runCode(mockData);
    assertThat(setupCalls).isEqualTo(1);
    assertApi('callInWindow').wasCalledWith('formbricks.track.call', null, 'checkout');
- name: user data is skipped without user id
  code: |-
    mock('callInWindow', (name, eventName, callback) => {
      if (name === 'formbricks.on') callback();
    });
    mockData.identifyUser = true;
    mockData.userId = undefined;
    mockData.userEmail = 'test@example.com';
    runCode(mockData);
    assertApi('callInWindow').wasNotCalledWith('formbricks.setEmail.call', null, 'test@example.com');
- name: failure when script cannot be loaded
  code: |-
    mock('injectScript', (url, onSuccess, onFailure) => {
      onFailure();
    });
    runCode(mockData);
    assertApi('callInWindow').wasNotCalled();
    assertApi('gtmOnFailure').wasCalled();
setup: |-
  const mockData = {
    workspaceId: 'test-workspace',
    appUrl: 'https://app.formbricks.com/'
  };
  mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
    assertThat(url).isEqualTo('https://app.formbricks.com/js/formbricks.umd.cjs');
    assertThat(cacheToken).isEqualTo('formbricks');
    onSuccess();
  });


